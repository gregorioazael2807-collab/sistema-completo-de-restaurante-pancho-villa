generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COCINA
  EMPLEADO
  CLIENTE
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NUEVO
  CONFIRMADO
  EN_PREPARACION
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
  NO_PRESENTADO
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  STRIPE
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AutomationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIEventKind {
  RECOMMENDATION
  CART_PROPOSAL
  ORDER_LOOKUP
  ADMIN_SUMMARY
  SAFETY_REFUSAL
}

// Identidades comerciales independientes de User (clientes y acceso heredado).
// Estos modelos no habilitan acceso al panel heredado ni aíslan aún sus datos.
model KitchenOwner {
  id             String             @id @default(cuid())
  email          String             @unique
  passwordHash   String
  name           String
  active         Boolean            @default(true)
  emailVerified  DateTime?
  sessionVersion Int                @default(0)
  restaurants    KitchenRestaurant[]
  // Activación privada de una instalación dedicada; no se asigna en registro público.
  kitchenUserId  String?            @unique
  kitchenUser    User?              @relation(fields: [kitchenUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model KitchenRestaurant {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  owner     KitchenOwner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  firstName           String               @default("")
  lastName            String               @default("")
  phone               String?
  role                Role                 @default(CLIENTE)
  locale              String               @default("es") @db.VarChar(5)
  timezone            String               @default("Europe/Berlin")
  active              Boolean              @default(true)
  sessionVersion      Int                  @default(0)
  customer            Customer?
  kitchenOwner        KitchenOwner?
  employee            Employee?
  addresses           Address[]
  orders              Order[]
  notifications       Notification[]
  aiAuditEvents       AIAuditEvent[]
  assistantMessages   AssistantMessage[]
  customerNotices     CustomerNotice[]
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role, active])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  notes     String?  @db.Text
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  title     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         String
  sortOrder    Int                   @default(0)
  active       Boolean               @default(true)
  products     Product[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([active, sortOrder])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String   @db.VarChar(5)
  name       String

  @@unique([categoryId, locale])
  @@index([locale])
}

model Product {
  id             String                 @id @default(cuid())
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug           String                 @unique
  name           String
  description    String                 @db.Text
  ingredients    String[]
  allergens      String[]
  price          Decimal                @db.Decimal(10, 2)
  currency       String                 @default("EUR") @db.Char(3)
  available      Boolean                @default(true)
  featured       Boolean                @default(false)
  sortOrder      Int                    @default(0)
  image          ProductImage?
  translations   ProductTranslation[]
  modifierGroups ProductModifierGroup[]
  recipe         Recipe?
  orderItems     OrderItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([categoryId, available, sortOrder])
  @@index([featured, available])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String  @db.VarChar(5)
  name        String
  description String  @db.Text

  @@unique([productId, locale])
  @@index([locale])
}

model ProductImage {
  id           String                    @id @default(cuid())
  productId    String                    @unique
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  src          String
  alt          String
  width        Int?
  height       Int?
  translations ProductImageTranslation[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ProductImageTranslation {
  id      String       @id @default(cuid())
  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  locale  String       @db.VarChar(5)
  alt     String

  @@unique([imageId, locale])
  @@index([locale])
}

model ModifierGroup {
  id           String                     @id @default(cuid())
  name         String
  required     Boolean                    @default(false)
  minSelect    Int                        @default(0)
  maxSelect    Int                        @default(1)
  active       Boolean                    @default(true)
  modifiers    Modifier[]
  translations ModifierGroupTranslation[]
  products     ProductModifierGroup[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model ModifierGroupTranslation {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  locale  String        @db.VarChar(5)
  name    String

  @@unique([groupId, locale])
  @@index([locale])
}

model Modifier {
  id             String                @id @default(cuid())
  groupId        String
  group          ModifierGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceDelta     Decimal               @default(0) @db.Decimal(10, 2)
  available      Boolean               @default(true)
  recipe         Recipe?
  orderModifiers OrderItemModifier[]
  translations   ModifierTranslation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([groupId, available])
}

model ModifierTranslation {
  id         String   @id @default(cuid())
  modifierId String
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  locale     String   @db.VarChar(5)
  name       String

  @@unique([modifierId, locale])
  @@index([locale])
}

model ProductModifierGroup {
  productId String
  groupId   String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String?
  recipient    String
  line1        String
  line2        String?
  city         String
  postalCode   String
  countryCode  String   @default("DE") @db.Char(2)
  deliveryNote String?  @db.Text
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

model Order {
  id                    String               @id @default(cuid())
  publicId              String               @unique
  idempotencyKey        String?              @unique
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  addressId             String?
  address               Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  type                  OrderType
  status                OrderStatus          @default(NUEVO)
  customerName          String
  customerEmail         String
  customerPhone         String
  customerLocale        String               @default("es") @db.VarChar(5)
  deliveryRecipient     String?
  deliveryLine1         String?
  deliveryLine2         String?
  deliveryCity          String?
  deliveryPostalCode    String?
  deliveryCountryCode   String?              @db.Char(2)
  deliveryNote          String?              @db.Text
  currency              String               @default("EUR") @db.Char(3)
  subtotal              Decimal              @db.Decimal(10, 2)
  taxRate               Decimal              @default(0) @db.Decimal(5, 4)
  taxAmount             Decimal              @db.Decimal(10, 2)
  deliveryFee           Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount        Decimal              @default(0) @db.Decimal(10, 2)
  total                 Decimal              @db.Decimal(10, 2)
  notes                 String?              @db.Text
  estimatedReadyAt      DateTime?
  estimatedReadyUntil   DateTime?
  estimatedArrivalAt    DateTime?
  estimatedArrivalUntil DateTime?
  preparationDeadlineAt DateTime?
  preparationStartedAt  DateTime?
  readyAt               DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  shiftId               String?
  shift                 KitchenShift?        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  inventoryComplete     Boolean              @default(false)
  ingredientCostCents   Int?
  reservations          StockReservation[]
  actions               OrderAction[]
  deliveryQuoteId       String?              @unique
  deliveryQuote         DeliveryQuote?       @relation(fields: [deliveryQuoteId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payment               Payment?
  notifications         Notification[]
  automationJobs        AutomationJob[]
  customerNotices       CustomerNotice[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([type, status, createdAt])
}

model OrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String
  quantity            Int
  unitPrice           Decimal             @db.Decimal(10, 2)
  lineTotal           Decimal             @db.Decimal(10, 2)
  instructions        String?             @db.Text
  allergens           String[]            @default([])
  allergensRecorded   Boolean             @default(false)
  recipeSnapshot      Json?
  stationId           String?
  stationName         String?
  prepMinutes         Int?
  prepMaxMinutes      Int?
  cookStatus          String              @default("PENDING")
  assignedTo          String?
  startedAt           DateTime?
  finishedAt          DateTime?
  estimatedAt         DateTime?
  estimatedUntil      DateTime?
  ingredientCostCents Int?
  modifiers           OrderItemModifier[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId   String?
  modifier     Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
  modifierName String
  priceDelta   Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  changedBy String?
  note      String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider       PaymentProvider @default(MANUAL)
  status         PaymentStatus   @default(PAYMENT_PENDING)
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("EUR") @db.Char(3)
  providerRef    String?         @unique
  idempotencyKey String?         @unique
  paidAt         DateTime?
  refundedAt     DateTime?
  method         String?
  refundedAmount Decimal         @default(0) @db.Decimal(10, 2)
  entries        PaymentEntry[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  dedupeKey String             @unique
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      String
  recipient String
  locale    String             @default("es") @db.VarChar(5)
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?            @db.Text
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([orderId, type])
}

model AutomationJob {
  id          String              @id @default(cuid())
  dedupeKey   String              @unique
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind        String
  status      AutomationJobStatus @default(PENDING)
  payload     Json
  attempts    Int                 @default(0)
  runAt       DateTime            @default(now())
  lockedAt    DateTime?
  lastError   String?             @db.Text
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, runAt])
  @@index([orderId, kind])
}

model AIAuditEvent {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      AIEventKind
  input     String?     @db.Text
  output    String?     @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

model RestaurantSettings {
  id                   String         @id @default(cuid())
  name                 String         @default("Pancho Villa")
  timezone             String         @default("Europe/Berlin")
  currency             String         @default("EUR") @db.Char(3)
  taxRate              Decimal        @default(0) @db.Decimal(5, 4)
  deliveryFee          Decimal        @default(0) @db.Decimal(10, 2)
  minDeliveryAmount    Decimal        @default(0) @db.Decimal(10, 2)
  pickupEnabled        Boolean        @default(true)
  deliveryEnabled      Boolean        @default(true)
  acceptingOrders      Boolean        @default(true)
  estimatedPrepMinutes Int            @default(25)
  latitude             Decimal?       @db.Decimal(10, 7)
  longitude            Decimal?       @db.Decimal(10, 7)
  dispatchMinMinutes   Int?
  dispatchMaxMinutes   Int?
  shifts               KitchenShift[]
  serviceMode          String         @default("LEGACY")
  updatedAt            DateTime       @updatedAt
}

model AssistantMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  role      String   @db.VarChar(10)
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([userId, requestId, role])
  @@index([userId, createdAt])
}

model CustomerNotice {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventKey  String
  status    OrderStatus
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
}

model KitchenStation {
  id       String   @id @default(cuid())
  name     String   @unique
  capacity Int      @default(1)
  active   Boolean  @default(true)
  recipes  Recipe[]
}

model Recipe {
  id          String             @id @default(cuid())
  productId   String?            @unique
  product     Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifierId  String?            @unique
  modifier    Modifier?          @relation(fields: [modifierId], references: [id], onDelete: Restrict)
  stationId   String
  station     KitchenStation     @relation(fields: [stationId], references: [id], onDelete: Restrict)
  minMinutes  Int
  maxMinutes  Int
  ingredients RecipeIngredient[]
  updatedAt   DateTime           @updatedAt
}

model Ingredient {
  id            String              @id @default(cuid())
  name          String              @unique
  unit          String
  stock         Decimal             @default(0) @db.Decimal(14, 3)
  reserved      Decimal             @default(0) @db.Decimal(14, 3)
  minimum       Decimal             @default(0) @db.Decimal(14, 3)
  unitCostCents Decimal             @default(0) @db.Decimal(14, 6)
  recipeLines   RecipeIngredient[]
  reservations  StockReservation[]
  movements     InventoryMovement[]
  updatedAt     DateTime            @updatedAt
}

model RecipeIngredient {
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(14, 3)

  @@id([recipeId, ingredientId])
}

model StockReservation {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(14, 3)
  state        String     @default("RESERVED")
  costCents    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([orderId, ingredientId])
}

model InventoryMovement {
  id            String     @id @default(cuid())
  key           String     @unique
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity      Decimal    @db.Decimal(14, 3)
  kind          String
  actorId       String
  orderId       String?
  note          String
  unitCostCents Decimal?   @db.Decimal(14, 6)
  createdAt     DateTime   @default(now())
}

model KitchenShift {
  id                String             @id @default(cuid())
  settingsId        String
  settings          RestaurantSettings @relation(fields: [settingsId], references: [id], onDelete: Restrict)
  activeKey         String?            @unique
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  openedBy          String
  closedBy          String?
  openingCashCents  Int                @default(0)
  countedCashCents  Int?
  expectedCashCents Int?
  differenceCents   Int?
  summary           Json?
  pauses            ShiftPause[]
  orders            Order[]

  @@index([closedAt, openedAt])
}

model ShiftPause {
  id        String       @id @default(cuid())
  shiftId   String
  shift     KitchenShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  startedAt DateTime     @default(now())
  endedAt   DateTime?
  actorId   String
}

model KitchenEvent {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String
  publicId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OrderAction {
  id        String   @id @default(cuid())
  key       String   @unique
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String
  kind      String
  payload   Json
  createdAt DateTime @default(now())
}

model PaymentEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  kind      String
  method    String
  amount    Decimal  @db.Decimal(10, 2)
  actorId   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DeliveryQuote {
  id          String   @id @default(cuid())
  addressHash String
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  straightKm  Decimal  @db.Decimal(10, 4)
  band        Int
  routeMeters Int?
  minSeconds  Int?
  maxSeconds  Int?
  method      String
  mode        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  order       Order?
}

model RouteReference {
  id          String   @id @default(cuid())
  band        Int
  minSeconds  Int
  maxSeconds  Int
  routeMeters Int?
  method      String
  mode        String
  orderId     String?  @unique
  createdAt   DateTime @default(now())

  @@index([band, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
