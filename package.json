{
  "name": "pancho-villa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3004",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p 3004",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "postinstall": "prisma generate",
    "dev:kitchen": "next dev --webpack -p 3005",
    "start:kitchen": "next start -p 3005",
    "kitchen:scheduler": "tsx scripts/run-kitchen-scheduler.ts",
    "test:kitchen": "playwright test --config playwright.kitchen.config.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.0.2",
    "sharp": "^0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "3.9.9",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.2"
  }
}
